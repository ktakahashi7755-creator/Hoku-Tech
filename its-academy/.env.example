# 必須: PostgreSQL 接続文字列 (npm run dev / npm start で使う)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/its_academy"
# 本番・ステージングは true (HTTPS 必須)。http://localhost で試す場合のみ false
COOKIE_SECURE="true"
# production / staging / test / local。NODE_ENV=production の既定は production
APP_ENV="production"

# docker compose 用: DB のパスワード (長いランダム文字列にする)
POSTGRES_PASSWORD=""
