# Git の管理対象から外すファイル

# 依存パッケージ
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# テスト結果
/coverage

# Next.js のビルド出力
/.next/
/out/

# 本番ビルド
/build

# その他
.DS_Store
*.pem

# デバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 環境変数ファイル (秘密情報を含むため管理しない。.env.example だけ管理する)
.env*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Playwright
/test-results/
/playwright-report/

# 教材サンプルのビルド成果物
/content/code/**/target/
/content/code/**/app.log
/content/code/**/body.txt
/content/code/**/headers.txt

# DB のバックアップ (scripts/backup.sh。個人情報を含む)
/backups/
